# .env.example — copy this file to .env and fill in your values

# === REQUIRED ===

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# EXBO API credentials from https://eapi.stalcraft.net
EXBO_CLIENT_ID=your_exbo_client_id_here
EXBO_CLIENT_SECRET=your_exbo_client_secret_here

# === OPTIONAL (defaults shown) ===

# StalCraft region (na or eu)
REGION=na

# Number of auction lots to fetch per scan (higher = more coverage)
AUCTION_LOT_LIMIT=100

# Scan settings
SCAN_BATCH_SIZE=3
SCAN_DELAY_SECONDS=1.0

# Profit thresholds for alerts
MIN_PROFIT_PCT=10.0
MIN_PROFIT_RUB=15000

# Confidence gate (0-100, higher = fewer false positives)
MIN_ALERT_CONFIDENCE=65

# Enable Discord alert dispatch (set to true when going live)
LIVE_MARKET_DATA=false

# Discord channel ID where the bot posts alerts
CHANNEL_ID=0

# Discord alert webhook (for the daily monitor)
DISCORD_ALERT_WEBHOOK=

# Community data sources (optional)
YOUTUBE_API_KEY=
TRADE_CHANNEL_IDS=
TRADE_FEED_URLS=
